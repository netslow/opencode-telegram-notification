# Telegram notification settings for the opencode telegram-notify plugin.
#
# Copy this file to `.env` next to the project root (or to
# ~/.config/opencode/.env) and fill in the values.

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional
TELEGRAM_ENABLED=true
TELEGRAM_TIMEOUT_SECONDS=10
TELEGRAM_RETRIES=2

# Optional notification language (supported: en, ru, es).
# TELEGRAM_LANGUAGE has the highest priority: it overrides the OpenCode
# language setting and the OS locale. It is re-read for every notification,
# so editing it does not require restarting OpenCode.
# If omitted, the plugin uses the OpenCode language setting (when available),
# then LANG/LC_ALL, then the system locale.
TELEGRAM_LANGUAGE=ru

# Optional HTTP(S) proxy (also honored when set in the process environment)
# HTTPS_PROXY=http://proxy.example.com:8080
# HTTP_PROXY=http://proxy.example.com:8080
# NO_PROXY=localhost,127.0.0.1
